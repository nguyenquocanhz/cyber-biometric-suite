<Window x:Class="FtpManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FtpManager"
        mc:Ignorable="d"
        Title="FTP File Manager &amp; Backup - Antigravity DevTool" Height="680" Width="1050"
        Background="#0f172a" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Modern ScrollViewer style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <!-- Button modern dark style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1d4ed8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#475569"/>
                    <Setter Property="Foreground" Value="#94a3b8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#334155"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#dc2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#b91c1c"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#16a34a"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15803d"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Form label style -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>

        <!-- TextBox style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563eb"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListView modern dark style -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#0f172a"/>
            <Setter Property="BorderBrush" Value="#1e293b"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" Value="#1e293b"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="Background" Value="#2563eb"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- 0: Connection Panel -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Files Manager Side-by-Side -->
            <RowDefinition Height="*"/>
            <!-- 2: Progress & Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: CONNECTION PANEL -->
        <Border Grid.Row="0" Background="#1e293b" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Profiles Dropdown -->
                    <ColumnDefinition Width="180"/>
                    <!-- Host / Server -->
                    <ColumnDefinition Width="2*"/>
                    <!-- Port -->
                    <ColumnDefinition Width="65"/>
                    <!-- Username -->
                    <ColumnDefinition Width="1.5*"/>
                    <!-- Password -->
                    <ColumnDefinition Width="1.5*"/>
                    <!-- Buttons -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Label Content="PROFILE ĐÃ LƯU"/>
                    <ComboBox x:Name="ProfileComboBox" SelectionChanged="ProfileComboBox_SelectionChanged" Background="#0f172a" Foreground="White" BorderBrush="#334155" Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <Label Content="HOST / IP MÁY CHỦ"/>
                    <TextBox x:Name="HostTextBox" Text="160.191.243.92" Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <Label Content="CỔNG"/>
                    <TextBox x:Name="PortTextBox" Text="21" Height="32" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <Label Content="TÀI KHOẢN"/>
                    <TextBox x:Name="UserTextBox" Text="nqatech_shopkcvip.com" Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <Label Content="MẬT KHẨU"/>
                    <PasswordBox x:Name="PassPasswordBox" Height="32" Background="#1e293b" Foreground="White" BorderBrush="#334155" Padding="8,6" CaretBrush="White"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,2">
                    <Button x:Name="ConnectBtn" Content="KẾT NỐI" Style="{StaticResource ModernButton}" Click="ConnectBtn_Click" Width="100" Margin="0,0,8,0" Height="32"/>
                    <Button x:Name="SaveProfileBtn" Content="LƯU LẠI" Style="{StaticResource SecondaryButton}" Click="SaveProfileBtn_Click" Width="85" Height="32"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: FILES SIDE-BY-SIDE -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <!-- Local Explorer -->
                <ColumnDefinition Width="*"/>
                <!-- Action Buttons (Center) -->
                <ColumnDefinition Width="130"/>
                <!-- Remote Explorer -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: LOCAL EXPLORER -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="⬆ Lên" Style="{StaticResource SecondaryButton}" Click="LocalUpBtn_Click" Width="55" Height="30" Padding="0"/>
                    <TextBox Grid.Column="1" x:Name="LocalPathTextBox" IsReadOnly="True" VerticalAlignment="Center" Margin="8,0" BorderBrush="#1e293b" Background="#0f172a" Height="30"/>
                    <Button Grid.Column="2" Content="Chọn thư mục" Style="{StaticResource SecondaryButton}" Click="SelectLocalDirBtn_Click" Height="30" Padding="10,0"/>
                </Grid>

                <ListView Grid.Row="1" x:Name="LocalListView" MouseDoubleClick="LocalListView_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Tên File / Thư mục" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" Foreground="{Binding IconColor}" FontWeight="Bold" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" Foreground="White"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Mệnh giá/Kích cỡ" DisplayMemberBinding="{Binding SizeDisplay}" Width="100"/>
                            <GridViewColumn Header="Ngày sửa đổi" DisplayMemberBinding="{Binding ModifiedDisplay}" Width="120"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <!-- CENTER PANEL: ACTIONS -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0">
                <Button x:Name="UploadBtn" Content="Tải lên ➜" Style="{StaticResource SuccessButton}" Click="UploadBtn_Click" Margin="0,0,0,12" Width="110"/>
                <Button x:Name="DownloadBtn" Content="⬅ Tải xuống" Style="{StaticResource ModernButton}" Click="DownloadBtn_Click" Margin="0,0,0,12" Width="110"/>
                <Button x:Name="BackupBtn" Content="📦 Backup ZIP" Style="{StaticResource SecondaryButton}" Click="BackupBtn_Click" Width="110"/>
            </StackPanel>

            <!-- RIGHT PANEL: REMOTE EXPLORER -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="RemoteUpBtn" Content="⬆ Lên" Style="{StaticResource SecondaryButton}" Click="RemoteUpBtn_Click" Width="55" Height="30" Padding="0" IsEnabled="False"/>
                    <TextBox Grid.Column="1" x:Name="RemotePathTextBox" IsReadOnly="True" VerticalAlignment="Center" Margin="8,0" BorderBrush="#1e293b" Background="#0f172a" Text="/" Height="30"/>
                    <Button Grid.Column="2" x:Name="RefreshRemoteBtn" Content="🔄 Tải lại" Style="{StaticResource SecondaryButton}" Click="RefreshRemoteBtn_Click" Height="30" Padding="10,0" IsEnabled="False"/>
                </Grid>

                <ListView Grid.Row="1" x:Name="RemoteListView" MouseDoubleClick="RemoteListView_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Tên File / Thư mục" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" Foreground="{Binding IconColor}" FontWeight="Bold" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" Foreground="White"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Kích cỡ" DisplayMemberBinding="{Binding SizeDisplay}" Width="100"/>
                            <GridViewColumn Header="Ngày sửa đổi" DisplayMemberBinding="{Binding ModifiedDisplay}" Width="120"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>

        <!-- ROW 2: PROGRESS & STATUS BAR -->
        <Border Grid.Row="2" Background="#1e293b" CornerRadius="6" Padding="12" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusTextBlock" Text="Hệ thống sẵn sàng." Foreground="#94a3b8" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                <ProgressBar Grid.Column="1" x:Name="TaskProgressBar" Height="14" Minimum="0" Maximum="100" Value="0" Background="#0f172a" Foreground="#2563eb" BorderThickness="0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
